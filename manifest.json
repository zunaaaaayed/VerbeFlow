{
  "manifest_version": 3,
  "name": "VerbeFlow — French verbs, explained",
  "version": "0.1.0",
  "description": "Offline French conjugations, tense formation notes, and bilingual examples.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "action": {"default_title": "VerbeFlow", "default_popup": "popup.html"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
