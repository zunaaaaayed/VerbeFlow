{
  "manifest_version": 3,
  "name": "VerbeFlow — French verbs, explained",
  "version": "0.2.0",
  "description": "Offline French conjugations, tense formation notes, and bilingual examples.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tts"
  ],
  "action": {
    "default_title": "Open VerbeFlow side panel",
    "default_icon": {
      "16": "assets/brand/verbeflow-16.png",
      "32": "assets/brand/verbeflow-32.png",
      "48": "assets/brand/verbeflow-48.png",
      "128": "assets/brand/verbeflow-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "assets/brand/verbeflow-16.png",
    "32": "assets/brand/verbeflow-32.png",
    "48": "assets/brand/verbeflow-48.png",
    "128": "assets/brand/verbeflow-128.png"
  }
}
